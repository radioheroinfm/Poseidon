{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poseidon",
  "version": "0.1.0",
  "identifier": "fm.radiohero.poseidon",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../src/renderer-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Hermes Agent Desktop on Tauri",
    "longDescription": "Native desktop shell for Hermes Agent, built with Tauri v2."
  }
}
