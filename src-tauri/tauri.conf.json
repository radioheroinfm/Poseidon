{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poseidon",
  "version": "0.1.0",
  "identifier": "fm.radiohero.poseidon",
  "build": {
    "frontendDist": "../src/renderer-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Poseidon — Hermes Desktop",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
